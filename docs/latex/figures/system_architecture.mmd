graph LR
  subgraph Client["Browser (Flutter PWA)"]
    UI[Flutter UI]
    JS[webauthn.js]
    NAV[navigator.credentials]
  end

  subgraph Auth["Authenticator"]
    PA[Platform Authenticator<br/>(Touch ID / Windows Hello)]
  end

  subgraph Gateway["Caddy Gateway :8080"]
    RP1[/Route: /api/* → backend:8000/]
    RP2[/Everything else → frontend:80/]
  end

  subgraph Backend["FastAPI (fido2 v2.0) :8000"]
    API[/ /api/v1/* /]
    S[Fido2Server]
    REDISQ[(Redis)]
    PG[(PostgreSQL)]
  end

  subgraph Frontend["Nginx :80"]
    FLUTTER[Flutter Web Build]
  end

  UI -->|HTTP GET /| Gateway
  JS --> NAV
  NAV --- PA

  Gateway -->|/api/*| Backend
  Gateway -->|/*| Frontend

  Backend <--> REDISQ
  Backend <--> PG

  UI -->|Fetch /api/v1/*| Gateway
  Frontend --> FLUTTER
