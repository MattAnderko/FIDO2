sequenceDiagram
  autonumber
  participant User as User
  participant Attacker as Attacker
  participant Service as Service
  participant OTP as OTP Provider

  User->>Attacker: enter username password
  Attacker->>Service: relay credentials
  Service-->>OTP: send one time code
  Attacker-->>User: prompt for otp
  User->>Attacker: enter otp
  Attacker->>Service: finish login using otp
  Service-->>Attacker: session cookies
  Attacker-->>User: fake success redirect
