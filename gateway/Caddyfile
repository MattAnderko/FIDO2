{
  auto_https off
}

:8080 {
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "publickey-credentials-get=(self)"
  }

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle {
    reverse_proxy {$FRONTEND_UPSTREAM}
  }
}
